# LIVE: NÃO HOMOLOGADO. Existe apenas para documentar a separação. Mesmo em LIVE, toda ação comercial
# continua bloqueada pelo GoLivePolicy enquanto os gates LEG/TAX/SUP/CH/OPS não estiverem APPROVED.
AIC_STACK=live
AIC_ENVIRONMENT=production
AIC_MODE=LIVE
AIC_JWT_SECRET=__INJETAR_VIA_SECRET_MANAGER__
AIC_SEED_DEMO_USERS=false
POSTGRES_PASSWORD=__INJETAR_VIA_SECRET_MANAGER__
POSTGRES_DB=aicommerce_live
AIC_DB_APP_PASSWORD=__INJETAR_VIA_SECRET_MANAGER__
AIC_PII_KEY=__INJETAR_VIA_SECRET_MANAGER__
AIC_WOO_WEBHOOK_SECRET=__INJETAR_VIA_SECRET_MANAGER__
AIC_METRICS_TOKEN=__INJETAR_VIA_SECRET_MANAGER__
# Domínio da API (HTTPS automático), origem do painel web e endereço público (base das URLs das fotos).
# scripts/gen_live_env.py --domain <domínio> preenche os três.
AIC_DOMAIN=api.sualoja.com.br
AIC_WEB_ORIGIN=https://api.sualoja.com.br
AIC_PUBLIC_BASE_URL=https://api.sualoja.com.br/api

# ── Loja WooCommerce real (passo 5 do docs/GUIA_PRODUCAO.md) ─────────────────────────────────────
# Só envia com o gate CH-WOO aprovado no app. Chave REST com permissão Leitura/Escrita.
#   AIC_WOO_BASE_URL=https://sualoja.com.br
#   AIC_WOO_CONSUMER_KEY=ck_...
#   AIC_WOO_CONSUMER_SECRET=cs_...

# ── Mercado Livre (passo 7) — aplicação criada no DevCenter do ML ───────────────────────────────
# Só publica com conta conectada no app (Canais → Conectar conta real) e gate CH-ML aprovado.
#   AIC_ML_APPLICATION_ID=<App ID>
#   AIC_ML_CLIENT_SECRET=<Secret Key>
#   AIC_ML_REDIRECT_URI=https://api.sualoja.com.br/api/v1/channels/MERCADO_LIVRE/oauth/callback

# ── IA dos agentes ──────────────────────────────────────────────────────────────────────────────
# mock = sem IA real e sem custo (padrão até a produção). Para usar o Gemini (chave do Google AI Studio):
#   AIC_LLM_PROVIDER=google
#   AIC_GOOGLE_API_KEY=<sua chave — só neste arquivo, nunca no código/chat>
# Modelos (opcional): AIC_GOOGLE_MODEL_SMALL=gemini-2.5-flash  AIC_GOOGLE_MODEL_ADVANCED=gemini-2.5-pro
# Teto de gasto mensal em micro-dólares (US$ 20 = 20000000): AIC_AI_MONTHLY_BUDGET_MICRO_USD=20000000
AIC_LLM_PROVIDER=mock
# Busca semântica da base de conhecimento (mesma chave do Gemini): AIC_KB_EMBEDDER=google e depois manage reindex-kb
AIC_KB_EMBEDDER=hashing
# Banco e Redis ficam só em 127.0.0.1 (compose); somente o proxy (TLS) é público.
