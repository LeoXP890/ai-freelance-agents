# Ambiente SIMULADO. Nenhuma credencial live pode existir aqui: a API recusa iniciar se encontrar
# variáveis LIVE_*, WOO_CONSUMER_*, ML_CLIENT_*, SHOPEE_PARTNER_*, TTS_APP_*, FISCAL_PROVIDER_*, ADS_*, PAYMENT_*.
AIC_STACK=dryrun
AIC_ENVIRONMENT=local
AIC_MODE=DRY_RUN
AIC_JWT_SECRET=dev-only-change-me-dev-only-change-me-local
AIC_SEED_DEMO_USERS=true
POSTGRES_USER=aicommerce
POSTGRES_PASSWORD=aicommerce
POSTGRES_DB=aicommerce
AIC_PG_PORT=55440
AIC_REDIS_PORT=56390
AIC_HTTP_PORT=8080
# Endereço do proxy na máquina: padrão 127.0.0.1 (fora da rede local). [::1] = só IPv6 local (use se a 8080 do
# IPv4 já estiver ocupada); 0.0.0.0 expõe na rede — só numa máquina de testes isolada.
# AIC_HTTP_BIND=127.0.0.1
AIC_WEB_ORIGIN=http://localhost:8080
AIC_PUBLIC_API_URL=http://localhost:8080/api
AIC_DB_APP_PASSWORD=aicommerce_app_dev

# ── IA dos agentes ──────────────────────────────────────────────────────────────────────────────
# mock = sem IA real e sem custo (padrão até a produção). Para usar o Gemini (chave do Google AI Studio):
#   AIC_LLM_PROVIDER=google
#   AIC_GOOGLE_API_KEY=<sua chave — só neste arquivo, nunca no código/chat>
# Modelos (opcional): AIC_GOOGLE_MODEL_SMALL=gemini-2.5-flash  AIC_GOOGLE_MODEL_ADVANCED=gemini-2.5-pro
# Teto de gasto mensal em micro-dólares (US$ 20 = 20000000): AIC_AI_MONTHLY_BUDGET_MICRO_USD=20000000
AIC_LLM_PROVIDER=mock
