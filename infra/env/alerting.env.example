# Destinos de alerta (INF-005). Copie para infra/env/alerting.env (ignorado pelo git).
ALERT_EMAIL_TO=voce@exemplo.com
ALERT_EMAIL_FROM=voce@gmail.com
ALERT_SMTP_HOST=smtp.gmail.com:587
ALERT_SMTP_USER=voce@gmail.com
# senha de app do Gmail: arquivo infra/env/secrets/smtp_password (uma linha) — NUNCA aqui
AIC_WHATSAPP_PROVIDER=dry
AIC_WHATSAPP_TO=5500000000000
AIC_WHATSAPP_PHONE_NUMBER_ID=
AIC_WHATSAPP_TEMPLATE=aic_alerta
AIC_WHATSAPP_TEMPLATE_LANG=pt_BR
AIC_WHATSAPP_API_VERSION=v23.0
# token de acesso da Meta: arquivo infra/env/secrets/whatsapp_token — NUNCA aqui
