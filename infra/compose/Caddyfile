# Local: HTTP em :8080. Produção (infra/compose/production.yml): AIC_SITE_ADDRESS=<domínio> → HTTPS automático
# (Let's Encrypt), redirecionamento de http para https e renovação do certificado pelo próprio Caddy.
{$AIC_SITE_ADDRESS::8080} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"  # navegadores só aplicam via https
		-Server
	}
	handle_path /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
