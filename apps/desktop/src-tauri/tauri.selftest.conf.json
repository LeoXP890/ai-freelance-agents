{
  "app": {
    "windows": [
      {
        "title": "AI Commerce",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "url": "index.html?selftest=http://127.0.0.1:9777",
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' http://localhost:8080 ws://localhost:8080 http://127.0.0.1:9777"
      }
    }
  }
}
