{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Commerce",
  "version": "0.1.0",
  "identifier": "br.com.aicommerce.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3210",
    "beforeDevCommand": "npm --prefix ../web run dev:desktop",
    "beforeBuildCommand": "npm --prefix ../web run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "AI Commerce",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http://localhost:8080 http://127.0.0.1:8080 http://localhost:8082 http://127.0.0.1:8082",
        "font-src": "'self' data:",
        "connect-src": "'self' http://localhost:8080 ws://localhost:8080 http://127.0.0.1:8080 ws://127.0.0.1:8080 http://localhost:8082 ws://localhost:8082 http://127.0.0.1:8082 ws://127.0.0.1:8082 https: wss:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Centro de comando do AI Commerce",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFMzVBMDkzRDdFODlCMTQKUldRVW0ralhrNkExVHVhMUIvQzdIREJCSnhWdHM3M3J1M2pURVhQamdBeWE5b08rdzJCcDRLUTIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
